#!/usr/bin/env bash
set -euo pipefail

DRY_RUN=0
VERBOSE=0
MAX_DEPTH=2
AGE_MINUTES=60
LITTER_AGE_MINUTES=1440
SCRATCH_DAYS=3

# TMPDIR roots scanned for top-level .NET litter.
TMP_ROOTS=(/tmp)

# Agent scratch trees, removed as a whole once idle for SCRATCH_DAYS. The second pattern covers
# sandboxes that point TMPDIR at a subdirectory of /tmp.
SCRATCH_GLOBS=(
    "/tmp/claude-$(id -u)/*/*"
    "/tmp/*/claude-$(id -u)/*/*"
)

# Machine-specific settings, sourced as Bash so it can extend the arrays above, e.g.
# TMP_ROOTS+=(/tmp/sandbox-tmp) or SCRATCH_GLOBS+=("/tmp/myproject-*").
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ccleanup.conf"
if [[ -f "$CONFIG" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG"
fi

usage() {
    echo "Usage: $0 [-n] [-v] [-d depth] [-s days]"
    echo "  -n        Dry run (show what would be removed)"
    echo "  -v        Verbose output"
    echo "  -d depth  Max directory depth to search (default: $MAX_DEPTH)"
    echo "  -s days   Idle days before agent scratch trees are removed (default: $SCRATCH_DAYS)"
    echo "Settings are read from $CONFIG if it exists."
    exit 1
}

while getopts "nvd:s:" opt; do
    case $opt in
        n) DRY_RUN=1 ;;
        v) VERBOSE=1 ;;
        d) MAX_DEPTH=$OPTARG ;;
        s) SCRATCH_DAYS=$OPTARG ;;
        *) usage ;;
    esac
done

# Unix socket paths bound in any network namespace we can see. `ss` only reports the host namespace,
# which misses sockets created inside containers.
declare -A active_sockets=()
while IFS= read -r path; do
    active_sockets[$path]=1
done < <(
    find /proc/[0-9]*/ns/net -maxdepth 0 -printf '%l %h\n' 2>/dev/null \
        | sort -u -k1,1 | awk '{ split($2, a, "/"); print a[3] }' \
        | while read -r pid; do cat "/proc/$pid/net/unix" 2>/dev/null || true; done \
        | awk '$8 ~ /^\// { print $8 }' | sort -u
)

# PIDs alive in any PID namespace. Names created inside containers embed container PIDs, which mean
# nothing to a host-side `kill -0`.
declare -A live_pids=()
while IFS= read -r pid; do
    live_pids[$pid]=1
done < <(cat /proc/[0-9]*/status 2>/dev/null \
           | awk '/^NSpid:/ { for (i = 2; i <= NF; i++) print $i }')

# Paths under /tmp that live processes have as cwd or hold open.
held_paths=$(find /proc/[0-9]*/cwd /proc/[0-9]*/fd -maxdepth 1 -printf '%l\n' 2>/dev/null \
               | grep '^/tmp/' | sort -u || true)

pid_alive() {
    [[ -n "${live_pids[$1]:-}" ]] || kill -0 "$1" 2>/dev/null
}

# Prints the PID embedded after $prefix in $name, or nothing.
extract_pid() {
    local name="$1" prefix="$2"
    if [[ "$name" =~ ^${prefix}([0-9]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    fi
}

socket_active() {
    local socket="$1" base pid
    [[ -n "${active_sockets[$socket]:-}" ]] && return 0

    base=$(basename "$socket")
    pid=$(extract_pid "$base" 'dotnet-diagnostic-')
    [[ -z "$pid" ]] && pid=$(extract_pid "$base" 'MSBuild')
    [[ -n "$pid" ]] && pid_alive "$pid"
}

# True if a live process has its cwd or an open file at or under $1.
held() {
    grep -qxF -- "$1" <<< "$held_paths" || grep -qF -- "$1/" <<< "$held_paths"
}

# True if anything under $1 was modified or created within the last $2 minutes.  ctime matters:
# copies (e.g. dotnet publish) can carry old mtimes. Tested via substitution rather than a pipe so
# that pipefail cannot let a permission error in find mask a match.
recently_touched() {
    [[ -n $(find "$1" \( -mmin -"$2" -o -cmin -"$2" \) -print -quit 2>/dev/null) ]]
}

# Formats a KiB count for humans, e.g. 1.5G.
human_kb() {
    numfmt --to=iec --from-unit=1024 "$1"
}

removed=0
skipped=0
failed=0
freed_kb=0

# Removes $1, crediting its size in KiB ($3) to freed_kb on success. A failed removal (read-only
# tree, another user's entry) is reported and counted instead of aborting the sweep.
remove_path() {
    local path="$1" reason="$2" kb="${3:-0}"
    if [[ $DRY_RUN -eq 1 ]]; then
        echo "WOULD REMOVE ($reason): $path"
    else
        [[ $VERBOSE -eq 1 ]] && echo "REMOVING ($reason): $path"
        if ! rm -rf -- "$path" 2>/dev/null; then
            echo "FAILED ($reason): $path" >&2
            ((failed++)) || true
            return 0
        fi
    fi
    ((removed++)) || true
    freed_kb=$((freed_kb + kb))
}

skip_path() {
    local path="$1" reason="$2"
    [[ $VERBOSE -eq 1 ]] && echo "SKIP ($reason): $path"
    ((skipped++)) || true
}

# Sockets anywhere under /tmp, activity-gated.
while IFS= read -r socket; do
    if socket_active "$socket"; then
        skip_path "$socket" "active socket"
    else
        remove_path "$socket" "stale socket"
    fi
done < <(find /tmp -maxdepth "$MAX_DEPTH" -type s 2>/dev/null | sort)

# CoreCLR debug pipes: clr-debug-pipe-<pid>-..., PID-gated.
while IFS= read -r pipe; do
    pid=$(extract_pid "$(basename "$pipe")" 'clr-debug-pipe-')
    if [[ -n "$pid" ]] && pid_alive "$pid"; then
        skip_path "$pipe" "pid $pid alive"
    else
        remove_path "$pipe" "stale clr-debug-pipe"
    fi
done < <(find /tmp -maxdepth "$MAX_DEPTH" -type p -name 'clr-debug-pipe-*' 2>/dev/null | sort)

# MSBuild directories: MSBuild<pid>* PID-gated; MSBuildTemp* age-gated (>AGE_MINUTES of idleness).
while IFS= read -r dir; do
    base=$(basename "$dir")
    if [[ "$base" == MSBuildTemp* ]]; then
        if recently_touched "$dir" "$AGE_MINUTES"; then
            skip_path "$dir" "MSBuildTemp active within ${AGE_MINUTES}m"
        else
            remove_path "$dir" "MSBuildTemp idle >${AGE_MINUTES}m"
        fi

        continue
    fi

    pid=$(extract_pid "$base" 'MSBuild')
    if [[ -z "$pid" ]]; then
        skip_path "$dir" "MSBuild dir without PID"
    elif pid_alive "$pid"; then
        skip_path "$dir" "pid $pid alive"
    else
        remove_path "$dir" "stale MSBuild dir"
    fi
done < <(find /tmp -maxdepth "$MAX_DEPTH" -type d -name 'MSBuild*' -prune 2>/dev/null | sort)

# NuGet case-sensitivity probe files: empty CASESENSITIVETEST<guid>, age-gated.
while IFS= read -r file; do
    remove_path "$file" "NuGet probe file"
done < <(find "${TMP_ROOTS[@]}" -mindepth 1 -maxdepth 1 -type f -user "$(id -un)" \
              -name 'CASESENSITIVETEST*' \
              -empty -mmin +"$AGE_MINUTES" 2>/dev/null | sort)

# Empty mkdtemp-style XXXXXX dirs the .NET SDK leaves behind on every build, age-gated.
while IFS= read -r dir; do
    remove_path "$dir" "empty .NET temp dir"
done < <(find "${TMP_ROOTS[@]}" -mindepth 1 -maxdepth 1 -type d -user "$(id -un)" \
              -regextype posix-extended -regex '.*/[A-Za-z0-9]{6}' \
              -empty -mmin +"$LITTER_AGE_MINUTES" 2>/dev/null | sort)

# Agent scratch trees: idle for SCRATCH_DAYS and not in use by any live process.
shopt -s nullglob
for pattern in "${SCRATCH_GLOBS[@]}"; do
    for path in $pattern; do
        [[ -O "$path" ]] || continue

        if recently_touched "$path" $((SCRATCH_DAYS * 1440)); then
            skip_path "$path" "scratch touched within ${SCRATCH_DAYS}d"
        elif held "$path"; then
            skip_path "$path" "scratch held by a live process"
        else
            # du exits non-zero on unreadable subdirectories but still prints a lower-bound total.
            kb=$(du -sk -- "$path" 2>/dev/null | cut -f1) || true
            kb=${kb:-0}
            remove_path "$path" "scratch idle >${SCRATCH_DAYS}d, $(human_kb "$kb")" "$kb"
        fi
    done
done

freed="$(human_kb "$freed_kb") from scratch trees"
if [[ $DRY_RUN -eq 1 ]]; then
    echo "Dry run: $removed items would be removed ($freed), $skipped active items kept."
else
    echo "Done: $removed items removed ($freed), $skipped active items kept, $failed failed."
    [[ $failed -eq 0 ]] || exit 1
fi
